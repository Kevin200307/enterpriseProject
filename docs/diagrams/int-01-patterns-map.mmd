        PRS["pricing-service"]
        TS["tracking-service"]
        AI["ai-assistant-service"]
    end

    MQ{{"RabbitMQ<br/>exchange parcel.events (topic)<br/>DLX swiftdrop.dlx"}}

    NS["notification-service"]
    MHOOK["Merchant webhook endpoint"]

    SPA ==>|"JWT bearer"| GW
    MSYS ==>|"X-Api-Key, bypasses gateway"| MS

    GW ==> IDS
