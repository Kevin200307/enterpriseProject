{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["global", "existingSecret", "services"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["imagePullPolicy", "environment"],
      "properties": {
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "existingSecret": {"type": "string", "minLength": 1},
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "image", "replicas", "port", "probePath", "resources"],
        "properties": {
          "enabled": {"type": "boolean"},
          "replicas": {"type": "integer", "minimum": 1, "maximum": 50},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "probePath": {"type": "string", "pattern": "^/"},
          "image": {
            "type": "object",
            "required": ["repository", "tag"],
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}}
            }
          },
          "resources": {
            "type": "object",
            "required": ["requests", "limits"]
          }
        }
      }
    }
  }
}
