# Copy to infra/.env and fill in real values. Never commit infra/.env.

# ---------------------------------------------------------------------------
# Neon Postgres — one database per service
# Use the DIRECT endpoint (no "-pooler" in the host): Flyway migrations and
# Hikari's own pooling don't play well with Neon's PgBouncer transaction mode.
# Format: jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require
# ---------------------------------------------------------------------------

DISPATCH_DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/dispatch_db?sslmode=require
DISPATCH_DB_USERNAME=dispatch_user
DISPATCH_DB_PASSWORD=change-me
# Shared only by dispatch and identity; generate a random secret of at least 32 characters.
DISPATCH_CLIENT_SECRET=

IDENTITY_DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/identity_db?sslmode=require
IDENTITY_DB_USERNAME=identity_user
IDENTITY_DB_PASSWORD=change-me

MERCHANT_DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/merchant_db?sslmode=require
MERCHANT_DB_USERNAME=merchant_user
MERCHANT_DB_PASSWORD=change-me

NOTIFICATION_DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/notification_db?sslmode=require
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=change-me

PARCEL_DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/parcel_db?sslmode=require
PARCEL_DB_USERNAME=parcel_user
PARCEL_DB_PASSWORD=change-me

PRICING_DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/pricing_db?sslmode=require
PRICING_DB_USERNAME=pricing_user
PRICING_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# RabbitMQ (local container) — used by dispatch, merchant, notification,
# parcel, tracking
# ---------------------------------------------------------------------------
RABBITMQ_USERNAME=swiftdrop
RABBITMQ_PASSWORD=change-me
# Management UI host port. Defaults to 15673 (not 15672) since another local
# project's RabbitMQ container may already be bound to 15672.
RABBITMQ_MANAGEMENT_HOST_PORT=15673

# ---------------------------------------------------------------------------
# Redis (local container) — used by gateway, identity, tracking
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me

# ---------------------------------------------------------------------------
# AI assistant — the service refuses to start without this
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-change-me

# ---------------------------------------------------------------------------
# Host port for the gateway (8080 is taken by another project on this machine)
# ---------------------------------------------------------------------------
GATEWAY_HOST_PORT=8081

# ---------------------------------------------------------------------------
# Mailpit & Notifications (NTF-2 / PLT-4)
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WEB_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Web (apps/web) — FE-1
# ---------------------------------------------------------------------------
# Host port the SPA is published on. The gateway's WEB_ORIGIN must include http://localhost:<this port>.
WEB_HOST_PORT=5174
# Gateway URL as seen by the BROWSER (not the Compose DNS name).
WEB_API_BASE_URL=http://localhost:8081
# Set to false to hide the AI chat widget (demo without network access).
ASSISTANT_ENABLED=true

# ---------------------------------------------------------------------------
# Identity service URL for internal service-to-service calls
# ---------------------------------------------------------------------------
IDENTITY_SERVICE_URL=http://identity-service:8080

# JWT contract shared by identity-service, gateway, and resource services
IDENTITY_ISSUER_URI=http://identity-service:8080
IDENTITY_JWKS_URI=http://identity-service:8080/.well-known/jwks.json
JWT_AUDIENCE=swiftdrop
IDENTITY_JWT_KEY_ID=swiftdrop-v1
# PKCS#8 private key and X.509 public key PEM strings; use literal \\n when stored on one line.
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OIDC credentials (IDN-3)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback
