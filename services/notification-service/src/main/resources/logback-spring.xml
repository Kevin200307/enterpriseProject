<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Register PII Masking Converter -->
    <conversionRule conversionWord="maskPii"
                    converterClass="lk.ac.mrt.swiftdrop.notification_service.logging.PiiMaskingConverter" />

    <!-- Console Appender with PII Masking -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%blue(%t)] %cyan(%logger{36}) : %maskPii(%msg)%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>